# Committed with working local-dev defaults (§4.8). Every value here guards nothing: the
# MinIO root credentials and the Postgres password are identical on every contributor's
# machine by design. Copy to `.env.local`, which is gitignored, and fill in the two Clerk
# keys if you want dev tier 2.
#
# Production values come from the provisioning runbook in §4.10 and live only in Vercel's
# env vars, GitHub Actions secrets or the operator's own `.env` — never in this repo.

# --- site -------------------------------------------------------------------
SITE_ORIGIN=http://localhost:3000

# --- database ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/xerhero

# The Neon serverless driver's HTTP endpoint. Locally this is the proxy from
# docker-compose; in production it is unset and the driver talks to Neon directly.
# This is the second of the two endpoint swaps that make dev and prod the same code.
NEON_FETCH_ENDPOINT=http://localhost:4444/sql

# --- blob storage (S3-compatible; MinIO locally, R2 in production) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=xerhero
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
BLOB_PUBLIC_ORIGIN=http://localhost:9000/xerhero

# --- auth (Clerk) -----------------------------------------------------------
# The one pair a contributor supplies themselves, at dev tier 2. Free, no card.
# Leave blank for tier 1: every signed-out surface works without them.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- abuse control (Cloudflare Turnstile, /report only) ---------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- operator ---------------------------------------------------------------
OPS_ALLOWED_USER_IDS=

# --- the sweep --------------------------------------------------------------
# The bearer secret the GitHub Actions schedule POSTs /api/sweep with every 15 minutes.
# Blank locally: /api/sweep answers 503 when it is unset, which is also what a fork PR gets.
SWEEP_SECRET=
