[
  {
    "AllowedOrigins": ["<site-origin>", "http://localhost:3000"],
    "AllowedMethods": ["PUT", "GET", "HEAD"],
    "AllowedHeaders": [
      "content-type",
      "content-encoding",
      "cache-control",
      "x-robots-tag",
      "x-amz-*"
    ],
    "ExposeHeaders": ["etag"],
    "MaxAgeSeconds": 3600
  }
]
